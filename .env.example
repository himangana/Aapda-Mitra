# Copy this file to .env and fill in local credentials. Never commit .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS tunnel URL used by Twilio during local development (for example, ngrok).
PUBLIC_BASE_URL=
# Comma-separated allowed dashboard origins. Set to the Vercel URL in Railway.
CORS_ORIGINS=http://localhost:5173
# Allows Vercel's generated frontend deployment URLs for this unauthenticated demo.
CORS_ORIGIN_REGEX=https://frontend-[a-z0-9-]+\\.vercel\\.app
SQLITE_DATABASE_PATH=aapda_mitra.db
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
DEEPGRAM_API_KEY=
RIME_API_KEY=
RAILWAY_API_TOKEN=
VERCEL_TOKEN=
